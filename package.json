{
  "name": "demo",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docker:up": "docker compose up",
    "docker:down": "docker compose down --rmi local -v && rm -f .migrated",
    "NOTE": "The docker:prod:up script is not intended for production deployment. It's for local build testing.",
    "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yaml up --build",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yaml down",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "npx prisma generate --config ./prisma.config.ts",
    "build": "tsc --noEmit && pkgroll",
    "typescript": "tsc --noEmit --pretty",
    "typescript:watch": "tsc --noEmit --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:verbose": "vitest --reporter verbose",
    "test:run": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "docker:test": "docker exec -it NODE_CONTAINER npm run test",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.2",
    "@types/source-map-support": "^0.5.10",
    "@vitest/eslint-plugin": "^1.5.2",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.5.0",
    "pkgroll": "^2.27.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}
